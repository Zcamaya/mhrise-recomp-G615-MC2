#version 450
// Built-in frame generation, 5: a 3x3 median of the finest vectors (each component on its own): a stray vector, from
// a block that matched something else, takes its neighbours' motion.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba32f) uniform readonly image2D src;
layout(binding = 1, rgba32f) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 size; ivec2 src_size; vec2 inv_src; int flags; int pad; } p;

float median9(float v[9]) {
    // (a partial sort: the fifth smallest)
    for (int i = 0; i < 5; i++)
        for (int j = i + 1; j < 9; j++)
            if (v[j] < v[i]) {
                float t = v[i];
                v[i] = v[j];
                v[j] = t;
            }
    return v[4];
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= p.size.x || q.y >= p.size.y) return;
    float xs[9], ys[9];
    float cost = 0.0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++) {
            vec4 f = imageLoad(src, clamp(q + ivec2(x, y), ivec2(0), p.size - 1));
            xs[(y + 1) * 3 + (x + 1)] = f.x;
            ys[(y + 1) * 3 + (x + 1)] = f.y;
            if (x == 0 && y == 0) cost = f.z;
        }
    imageStore(dst, q, vec4(median9(xs), median9(ys), cost, 0.0));
}

#version 450
// Built-in frame generation, 4: a finer level's vectors (a 4x4 block each, as at the coarser level, which has half its
// texels and so a vector per 2x2 of these blocks). Candidates: the coarser vectors of this block and its three nearest
// neighbours (doubled: a texel there is two here), their average and no motion; the best one, then the best of its
// 3x3 one texel steps. A small cost for leaving the coarser vector keeps the field smooth. At the last level (flags 1)
// a parabola through the costs either side gives the vector below a texel.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba32f) uniform readonly image2D coarse;
layout(binding = 1, r32f) uniform readonly image2D lum_a;
layout(binding = 2, r32f) uniform readonly image2D lum_b;
layout(binding = 3, rgba32f) uniform writeonly image2D field;
layout(push_constant) uniform P { ivec2 size; ivec2 src_size; vec2 inv_src; int flags; int coarse_w; } p;

ivec2 coarse_size() { return ivec2(p.coarse_w & 0xffff, p.coarse_w >> 16); }

float load(bool a, ivec2 at) {
    at = clamp(at, ivec2(0), p.src_size - 1);
    return a ? imageLoad(lum_a, at).r : imageLoad(lum_b, at).r;
}

float cost_of(ivec2 base, ivec2 d, vec2 prior) {
    float cost = 0.0;
    for (int y = 0; y < 4; y++)
        for (int x = 0; x < 4; x++) {
            ivec2 at = base + ivec2(x, y);
            cost += abs(load(true, at - d) - load(false, at + d));
        }
    vec2 off = vec2(d) - prior;
    return cost + 0.03 * (abs(off.x) + abs(off.y));
}

vec2 coarse_at(ivec2 c) { return imageLoad(coarse, clamp(c, ivec2(0), coarse_size() - 1)).xy * 2.0; }

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= p.size.x || q.y >= p.size.y) return;
    ivec2 base = q * 4;
    // (this block's quarter of its coarser block: the neighbours on that side)
    ivec2 c = q / 2, side = ivec2((q.x & 1) == 0 ? -1 : 1, (q.y & 1) == 0 ? -1 : 1);
    vec2 cands[6];
    cands[0] = coarse_at(c);
    cands[1] = coarse_at(c + ivec2(side.x, 0));
    cands[2] = coarse_at(c + ivec2(0, side.y));
    cands[3] = coarse_at(c + side);
    cands[4] = (cands[0] + cands[1] + cands[2] + cands[3]) * 0.25;
    cands[5] = vec2(0.0);
    vec2 prior = cands[0];
    float best = 1e9;
    ivec2 bestd = ivec2(0);
    for (int i = 0; i < 6; i++) {
        ivec2 d = ivec2(round(cands[i]));
        float cost = cost_of(base, d, prior);
        if (cost < best) {
            best = cost;
            bestd = d;
        }
    }
    ivec2 centre = bestd;
    float costs[9];
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++) {
            ivec2 d = centre + ivec2(x, y);
            float cost = cost_of(base, d, prior);
            costs[(y + 1) * 3 + (x + 1)] = cost;
            if (cost < best) {
                best = cost;
                bestd = d;
            }
        }
    vec2 v = vec2(bestd);
    if ((p.flags & 1) != 0 && bestd == centre) {  // (the best is the middle of the 3x3: its sides are known)
        float l = costs[3], r = costs[5], u = costs[1], dn = costs[7], m = costs[4];
        float ex = l - 2.0 * m + r, ey = u - 2.0 * m + dn;
        if (ex > 1e-5) v.x += clamp(0.5 * (l - r) / ex, -0.5, 0.5);
        if (ey > 1e-5) v.y += clamp(0.5 * (u - dn) / ey, -0.5, 0.5);
    }
    imageStore(field, q, vec4(v, best, 0.0));
}

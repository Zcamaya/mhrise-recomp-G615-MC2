+namespace {
+// A float's half bits, rounded to nearest even, with integer operations only: infinity and NaN stay so, what's too
+// big for a half becomes infinity. Normal halves and denormals go through the same rounding shift (13 bits for a
+// normal one, 14 to 25 for a denormal). Not the usual magic-number version (a float add for the denormals, one
+// constant for rebias and rounding): ARM's compiler took that for a half conversion and crashed on it all the same.
+Id HalfBits(EmitContext& ctx, Id value) {
+    const Id u32{ctx.U32[1]};
+    const Id bits{ctx.OpBitcast(u32, value)};
+    const Id sign{ctx.OpShiftRightLogical(u32, ctx.OpBitwiseAnd(u32, bits, ctx.Const(0x80000000U)), ctx.Const(16U))};
+    const Id abs{ctx.OpBitwiseAnd(u32, bits, ctx.Const(0x7fffffffU))};
+    const Id denormal{ctx.OpULessThan(ctx.U1, abs, ctx.Const(0x38800000U))};
+    // Denormal: the mantissa with its leading 1, shifted by how far the exponent is below the smallest normal half
+    const Id exponent{ctx.OpShiftRightLogical(u32, abs, ctx.Const(23U))};
+    const Id mantissa{ctx.OpBitwiseOr(u32, ctx.OpBitwiseAnd(u32, abs, ctx.Const(0x7fffffU)), ctx.Const(0x800000U))};
+    const Id far{ctx.OpUMin(u32, ctx.OpISub(u32, ctx.Const(126U), exponent), ctx.Const(25U))};
+    // Normal: the exponent rebiased in place, so a rounding carry goes into it
+    const Id source{ctx.OpSelect(u32, denormal, mantissa, ctx.OpISub(u32, abs, ctx.Const(0x38000000U)))};
+    const Id shift{ctx.OpSelect(u32, denormal, far, ctx.Const(13U))};
+    const Id truncated{ctx.OpShiftRightLogical(u32, source, shift)};
+    const Id rest{ctx.OpBitwiseAnd(u32, source, ctx.OpISub(u32, ctx.OpShiftLeftLogical(u32, ctx.Const(1U), shift), ctx.Const(1U)))};
+    const Id tie{ctx.OpShiftLeftLogical(u32, ctx.Const(1U), ctx.OpISub(u32, shift, ctx.Const(1U)))};
+    const Id odd{ctx.OpINotEqual(ctx.U1, ctx.OpBitwiseAnd(u32, truncated, ctx.Const(1U)), ctx.Const(0U))};
+    const Id up{ctx.OpLogicalOr(ctx.U1, ctx.OpUGreaterThan(ctx.U1, rest, tie),
+                                ctx.OpLogicalAnd(ctx.U1, ctx.OpIEqual(ctx.U1, rest, tie), odd))};
+    Id half{ctx.OpIAdd(u32, truncated, ctx.OpSelect(u32, up, ctx.Const(1U), ctx.Const(0U)))};
+    const Id nan{ctx.OpUGreaterThan(ctx.U1, abs, ctx.Const(0x7f800000U))};
+    const Id big{ctx.OpSelect(u32, nan, ctx.Const(0x7e00U), ctx.Const(0x7c00U))};
+    half = ctx.OpSelect(u32, ctx.OpUGreaterThanEqual(ctx.U1, abs, ctx.Const(0x47800000U)), big, half);
+    return ctx.OpBitwiseOr(u32, half, sign);
+}
+} // Anonymous namespace
+
 Id EmitPackHalf2x16(EmitContext& ctx, Id value) {
+    if (ctx.profile.has_broken_pack_half && ctx.stage != Stage::Fragment && ctx.stage != Stage::Compute) {
+        const Id low{HalfBits(ctx, ctx.OpCompositeExtract(ctx.F32[1], value, 0U))};
+        const Id high{HalfBits(ctx, ctx.OpCompositeExtract(ctx.F32[1], value, 1U))};
+        return ctx.OpBitwiseOr(ctx.U32[1], low, ctx.OpShiftLeftLogical(ctx.U32[1], high, ctx.Const(16U)));
+    }
     return ctx.OpPackHalf2x16(ctx.U32[1], value);
 }
 
